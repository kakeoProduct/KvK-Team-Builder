{
  "description": "Git保護、Review Agentの読み取り専用の強制、レビュー結果の形式の検査（ADR 0031）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/block_dangerous_git.py\"",
            "commandWindows": "for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python \"%r/tools/hooks/block_dangerous_git.py\"",
            "statusMessage": "Gitコマンドの安全性を確認しています"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|spawn_agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/hooks/enforce_read_only_agent.py\"",
            "commandWindows": "for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python \"%r/tools/hooks/enforce_read_only_agent.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel)\" && python3 \"$root/tools/hooks/check_review_report.py\"",
            "commandWindows": "for /f \"delims=\" %r in ('git rev-parse --show-toplevel') do @python \"%r/tools/hooks/check_review_report.py\""
          }
        ]
      }
    ]
  }
}
